# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — usado tanto pelo Prisma quanto pelo
# Checkpointer do LangGraph (PostgresSaver). Mantemos uma única URL para
# evitar divergência entre as duas camadas de persistência.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agente_dt?schema=public"

# ---------------------------------------------------------------------------
# Kommo CRM — Long-Lived Access Token (gerado em Configurações > Integrações).
# Nunca commitar. O subdomínio identifica a conta (ex: meuespaco.kommo.com).
# ---------------------------------------------------------------------------
KOMMO_SUBDOMAIN="seu-subdominio"
KOMMO_ACCESS_TOKEN="seu-token-kommo"

# ---------------------------------------------------------------------------
# OpenAI — modelo usado pelo agente (gpt-4o-mini por padrão).
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
LOG_LEVEL="debug"

# Origem do dashboard React (CORS).
FRONTEND_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Alertas no Telegram do João (bot @ddavisos_bot, o mesmo da central de chamados).
# Hoje: "agendamento perdido" e "paciente sem resposta há 5 min" (automação alerta-sem-resposta).
# Sem o token, nada é enviado (só log).
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_JOAO=7822226023

# ---------------------------------------------------------------------------
# Asaas — escrita pelo conector MCP (cadastrar cliente e gerar boleto, em dois passos).
# NASCE DESLIGADA: sem ASAAS_ESCRITA_UNIDADES nenhuma unidade grava. Quem pode usar continua
# sendo a lista MCP_ESCRITA_EMAILS; aqui se escolhe EM QUAIS unidades.
# ---------------------------------------------------------------------------
# Slugs separados por vírgula (ex.: doutor-hernia-serra). Vazio/ausente = desligado em todas. "*" não vale.
# ASAAS_ESCRITA_UNIDADES=
# Teto por boleto, em reais (padrão 5000). 0 ou valor inválido = geração de boleto DESLIGADA, nunca "sem limite".
# ASAAS_COBRANCA_MAX_REAIS=5000
# Boletos por hora e por conta (padrão 20). 0 ou valor inválido = geração de boleto DESLIGADA.
# ASAAS_COBRANCAS_POR_HORA=20
