# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — usado tanto pelo Prisma quanto pelo
# Checkpointer do LangGraph (PostgresSaver). Mantemos uma única URL para
# evitar divergência entre as duas camadas de persistência.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agente_dt?schema=public"

# ---------------------------------------------------------------------------
# Kommo CRM — Long-Lived Access Token (gerado em Configurações > Integrações).
# Nunca commitar. O subdomínio identifica a conta (ex: meuespaco.kommo.com).
# ---------------------------------------------------------------------------
KOMMO_SUBDOMAIN="seu-subdominio"
KOMMO_ACCESS_TOKEN="seu-token-kommo"

# ---------------------------------------------------------------------------
# OpenAI — modelo usado pelo agente (gpt-4o-mini por padrão).
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV="development"
LOG_LEVEL="debug"

# Origem do dashboard React (CORS).
FRONTEND_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Alertas no Telegram do João (bot @ddavisos_bot, o mesmo da central de chamados).
# Hoje: "agendamento perdido" e "paciente sem resposta há 5 min" (automação alerta-sem-resposta).
# Sem o token, nada é enviado (só log).
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_JOAO=7822226023

# ---------------------------------------------------------------------------
# Vigia de vídeo no conector (video_gravacoes / video_folhas / video_clipe): a gerente analisa gravações de câmera (OBS) de 10+ h.
# O vídeo NUNCA sobe; o PC que grava manda só o pacote da triagem (folhas, índice, clipes leves) para VIGIA_DIR (ops/vigia-video/README.md).
# Precisa das DUAS variáveis e de MCP_URL_PUBLICA; sem uma delas as ferramentas e a rota do clipe não existem.
# ---------------------------------------------------------------------------
# Quem vê (csv de e-mails de usuários ATIVOS do console): só a gerente e o João. É imagem de câmera de funcionário.
# MCP_VIDEO_EMAILS=doutordigitalconsultoria@gmail.com
# Pasta com os pacotes (/srv/vigia/<camera>/<AAAA-MM-DD_HHMM>/...). Monte SOMENTE LEITURA no container; o backend nunca escreve nela.
# VIGIA_DIR=/vigia
# Pacotes mais antigos que isto (dias, 1 a 365; padrão 30) deixam de ser listados e de abrir. Apagar do disco é a limpeza do README.
# VIGIA_RETENCAO_DIAS=30

# ---------------------------------------------------------------------------
# Resumo diário da qualidade da Sofia no Telegram do João (07:30 SP; sábado traz também o da semana). SEM IA.
# Global (rede toda), não por unidade. seco = só registra o texto no log (padrão se vazio) | ligado = envia | desligado.
# Precisa de TELEGRAM_BOT_TOKEN. Vale no próximo reinício do backend.
# ---------------------------------------------------------------------------
# RESUMO_DIARIO_IA=seco
# Asaas — escrita pelo conector MCP, DIRETA (sem preparar/confirmar): cliente, cobrança (boleto/Pix/cartão/parcelado), editar, cancelar,
# estornar e transferir. NASCE DESLIGADA: sem ASAAS_ESCRITA_UNIDADES nenhuma unidade grava. Quem pode usar continua
# sendo a lista MCP_ESCRITA_EMAILS; aqui se escolhe EM QUAIS unidades. Aviso de cada transferência/estorno/cancelamento vai
# pelo Telegram (TELEGRAM_BOT_TOKEN).
# ---------------------------------------------------------------------------
# Slugs separados por vírgula (ex.: doutor-hernia-serra). Vazio/ausente = desligado em todas. "*" não vale.
# ASAAS_ESCRITA_UNIDADES=
# Teto por operação (cobrança criada, estorno, transferência), em reais. Padrão 5000. Vazio, 0 ou inválido = o padrão (nunca "sem limite").
# (o nome antigo ASAAS_COBRANCA_MAX_REAIS ainda vale como segunda opção; com 0 ou lixo nele o dinheiro pelo conector fica DESLIGADO até a variável ser apagada)
# ASAAS_TETO_OPERACAO_REAIS=5000
# Teto por DIA e por CHAVE do Asaas (soma de cobranças criadas + estornos + transferências, no fuso da clínica; duas clínicas com a mesma chave somam
# juntas). Padrão 20000. Vazio/0/inválido = o padrão. Lido do banco (mcp_auditoria) dentro de uma trava por chave: vale entre instâncias do servidor.
# ASAAS_TETO_DIA_REAIS=20000
# Teto PRÓPRIO de estorno e de transferência (o dinheiro que SAI; menor de propósito, porque é por onde um texto injetado viraria prejuízo). Vale o MENOR entre o
# próprio e o geral. Por operação e por dia (cada tipo soma só o seu). Padrão 500 e 2000; vazio/0/inválido = o padrão. O João sobe se precisar.
# ASAAS_TETO_ESTORNO_OPERACAO_REAIS=500
# ASAAS_TETO_ESTORNO_DIA_REAIS=2000
# ASAAS_TETO_TRANSFERENCIA_OPERACAO_REAIS=500
# ASAAS_TETO_TRANSFERENCIA_DIA_REAIS=2000
# Cancelamentos de cobrança por hora e por chave do Asaas (cancelar é irreversível e não gasta teto de valor). Padrão 10; vazio/0/inválido = o padrão.
# ASAAS_CANCELAMENTOS_POR_HORA=10
# Cobranças criadas por hora e por conta (padrão 20). 0 ou valor inválido = criação de cobrança DESLIGADA.
# ASAAS_COBRANCAS_POR_HORA=20
# Destinos PERMITIDOS para transferência, por clínica (JSON, uma linha). Ausente/vazio/inválido = transferência DESLIGADA. O destino só entra aqui,
# nunca pelo chat. Pix: {"nome","apelido","chave_pix","tipo_chave"(CPF|CNPJ|EMAIL|PHONE|EVP)}; conta: {"nome","apelido","banco","agencia","conta","conta_digito","tipo_conta","titular","documento"}.
# ASAAS_TRANSFERENCIA_DESTINOS={"doutor-hernia-serra":[{"nome":"Fornecedor Exemplo LTDA","apelido":"fornecedor","chave_pix":"11222333000181","tipo_chave":"CNPJ"}]}

# ---------------------------------------------------------------------------
# Agenda da franquia no Calendario do Kommo (/todo/calendar): cada agendamento vira UMA tarefa no horario
# da consulta, marcada com [ag:<idSchedule>] no texto. So cria/atualiza/conclui TAREFA - nao grava campo
# do cartao, entao funciona numa unidade que NAO esta em FRANQUIA_SYNC_SLUGS.
# NASCE DESLIGADO e, depois de ligado, em MODO SECO (so registra no log o que faria).
# ---------------------------------------------------------------------------
# Unidades onde o passo roda (csv; "*" = todas). Vazio = desligado.
# FRANQUIA_CALENDARIO_SLUGS=doutor-hernia-timbo
# Unidades onde ele ESCREVE no Kommo (csv). Fora desta lista = seco. So ligar depois de conferir o log.
# FRANQUIA_CALENDARIO_APLICAR=
# Dono das tarefas, por unidade: slug:userId do Kommo (csv). Sem ele, a tarefa nasce com o dono do token.
# FRANQUIA_CALENDARIO_RESPONSAVEL=doutor-hernia-timbo:15905863
# Tipo da tarefa, por unidade: slug:taskTypeId (csv). Sem ele procura o tipo "Consulta" da conta; sem esse a unidade FICA PARADA (log avisa).
# ATENCAO: TROCAR O TIPO DEPOIS DE CRIAR TAREFAS DUPLICA A AGENDA INTEIRA - a leitura e filtrada por tipo e deixa de ver as antigas.
# Se precisar trocar, conclua/feche antes as tarefas [ag:...] do tipo antigo.
# FRANQUIA_CALENDARIO_TIPO=doutor-hernia-timbo:4302851
# Duracao da tarefa em minutos (padrao 60; 0 = nao manda duracao).
# FRANQUIA_CALENDARIO_DURACAO_MIN=60
# REMARCADO na franquia: "manter" (padrao; a franquia muda a data no mesmo registro, o paciente vem) ou "fechar".
# FRANQUIA_CALENDARIO_REMARCADO=manter

# ---------------------------------------------------------------------------
# Cofre de envio de arquivos do conector (arquivo_pedir_upload / arquivo_ver_envio / arquivo_link_temporario / arquivo_apagar):
# a pessoa sobe um PDF/Word/imagem/texto numa página nossa e o Claude entrega a OUTRO conector (ClickSign) um link de download
# curto. Arquivo cifrado em repouso, apagado em minutos (no máx. 2 h). Só roda com MCP_URL_PUBLICA definida.
# Quem usa: MCP_ESCRITA_EMAILS (quem já escreve) MAIS os e-mails de MCP_ARQUIVOS_EMAILS (só o cofre, sem escrita no Kommo/Asaas).
# ---------------------------------------------------------------------------
# MCP_ARQUIVOS_EMAILS=suzanne@exemplo.com,lia@exemplo.com
# Pasta dos arquivos cifrados (o app cria com permissão 0700). Padrão: /tmp/dd-arquivos do container. Tem que ser PRIVADA deste container: ao
# subir e ao desligar o app APAGA tudo o que for do cofre nela (nunca aponte para volume compartilhado entre containers).
# ARQUIVOS_DIR=
# Tamanho máximo em MB (1 a 20; padrão 20: o container tem 1 GB e o envio fica na memória durante a conferência).
# ARQUIVOS_TAMANHO_MAX_MB=20

# Anexar comprovante/nota/recibo a lançamento do Caixa/Financeiro (sistemas_preparar_anexo / sistemas_anexar_envio / sistemas_anexar_url). Reaproveita o cofre acima
# (mesmo domínio do link de envio = o de MCP_URL_PUBLICA). Só para quem está em MCP_ESCRITA_EMAILS.
# Domínios EXTRAS de onde o servidor pode baixar (sistemas_anexar_url), separados por vírgula; o padrão já tem recibo.infinitepay.io, asaas.com e *.asaas.com. Só o João mexe.
# ANEXO_URL_DOMINIOS=
# Em nome de quem o arquivo fica gravado em caixa_docs.enviado_nome (padrão: Lia (pela Suzanne)).
# ANEXO_ENVIADO_NOME="Lia (pela Suzanne)"
# Quantas vezes cada link de download abre (1 a 10; padrão 3).
# ARQUIVOS_BAIXADAS_MAX=3
