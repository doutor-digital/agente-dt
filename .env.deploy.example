# .env do DEPLOY na VPS — vive em /opt/doutordigital/agente-dt/.env
# (NÃO commitar o .env real; este é só o molde.)
#
# É lido em dois momentos:
#  1) pelo workflow (set -a; . .env) p/ interpolar image/labels no compose;
#  2) pelo container (env_file) p/ as variáveis de app.

# ── infra do deploy (interpolado no docker-compose.yml) ─────────────────────
GHCR_OWNER=doutor-digital
AGENT_DOMAIN=agente-vps.doutordigitalconsultoria.com
IMAGE_TAG=latest          # o workflow sobrescreve com o SHA do commit

# ── banco (novo, no Postgres da VPS) ────────────────────────────────────────
# kommodb_db = alias de rede do PG18 na overlay portainer-next.
DATABASE_URL=postgresql://agente:TROQUE_A_SENHA@kommodb_db:5432/agente_dt?schema=public

# ── Kommo (default global; cada Unit no banco pode ter o seu) ────────────────
KOMMO_SUBDOMAIN=attivacorpoementeitz
KOMMO_ACCESS_TOKEN=coloque_o_token

# opcionais Kommo
# KOMMO_SALESBOT_ID=
# KOMMO_REPLY_FIELD_ID=

# ── LLM ──────────────────────────────────────────────────────────────────────
# OPENAI é OBRIGATÓRIO (embeddings/RAG + transcrição de áudio) mesmo usando Claude.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Anthropic é por-unidade no banco; se houver um global, adicione aqui.
# ANTHROPIC_API_KEY=

# ── auth do painel ──────────────────────────────────────────────────────────
SESSION_JWT_SECRET=troque_por_uma_string_de_no_minimo_32_caracteres
# AUTH_COOKIE_DOMAIN=.doutordigitalconsultoria.com
# FRONTEND_ORIGIN=https://<painel-do-agente>

# ── operação ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
STALE_REPLY_ALERT_MINUTES=3
